#include <bang.h>
#include <cnrt.h>
#include <stdint.h>
#include <torch/extension.h>

#define MAX_LEN 8192
#define MAX_KW 512

__mlu_entry__ void conv1d_kernel(const half *x,
                                 const half *weight,
                                 const half *bias,
                                 half *output,
                                 int batch,
                                 int in_channels,
                                 int out_channels,
                                 int length,
                                 int kernel_size,
                                 int stride,
                                 int padding,
                                 int dilation,
                                 int groups,
                                 int L_out,
                                 int has_bias) {
    __nram__ half nram_x[MAX_LEN];
    __nram__ half nram_w[MAX_KW];
    __nram__ float nram_acc[MAX_LEN];
    __nram__ half nram_out[MAX_LEN];
    __nram__ half nram_bias[1];

    int ic_per_group = in_channels / groups;
    int oc_per_group = out_channels / groups;

    int total_tasks = batch * out_channels;

    for (int task = taskId; task < total_tasks; task += taskDim) {
        int b = task / out_channels;
        int oc = task % out_channels;
        int g = oc / oc_per_group;

        int w_size = ic_per_group * kernel_size;
        __memcpy(nram_w, weight + oc * w_size,
                 w_size * sizeof(half), GDRAM2NRAM);

        float bias_val = 0.0f;
        if (has_bias) {
            __memcpy(nram_bias, bias + oc, sizeof(half), GDRAM2NRAM);
            bias_val = (float)nram_bias[0];
        }

        for (int i = 0; i < L_out; ++i) {
            nram_acc[i] = bias_val;
        }

        for (int ic = 0; ic < ic_per_group; ++ic) {
            int gic = g * ic_per_group + ic;

            __memcpy(nram_x,
                     x + ((int64_t)b * in_channels + gic) * length,
                     length * sizeof(half), GDRAM2NRAM);

            for (int ow = 0; ow < L_out; ++ow) {
                float acc = 0.0f;
                for (int kw = 0; kw < kernel_size; ++kw) {
                    int iw = ow * stride - padding + kw * dilation;
                    if (iw >= 0 && iw < length) {
                        acc += (float)nram_x[iw] *
                               (float)nram_w[ic * kernel_size + kw];
                    }
                }
                nram_acc[ow] += acc;
            }
        }

        for (int i = 0; i < L_out; ++i) {
            nram_out[i] = (half)nram_acc[i];
        }

        __memcpy(output + ((int64_t)b * out_channels + oc) * L_out,
                 nram_out, L_out * sizeof(half), NRAM2GDRAM);
    }
}

torch::Tensor bang_func(torch::Tensor x,
                        torch::Tensor weight,
                        int in_channels,
                        int out_channels,
                        int kernel_size,
                        int stride,
                        int padding,
                        int dilation,
                        int groups,
                        int bias) {
    auto x_c = x.to(torch::kHalf).contiguous();
    auto w_c = weight.to(torch::kHalf).contiguous();

    int batch = static_cast<int>(x_c.size(0));
    int length = static_cast<int>(x_c.size(2));
    int L_out = (length + 2 * padding - dilation * (kernel_size - 1) - 1) / stride + 1;

    auto output = torch::empty({batch, out_channels, L_out},
                               x_c.options().dtype(torch::kHalf));

    int total_tasks = batch * out_channels;
    if (total_tasks == 0) {
        return output;
    }

    uint32_t task_num = 16;
    if (total_tasks < static_cast<int>(task_num)) {
        task_num = static_cast<uint32_t>(total_tasks);
    }

    int has_bias = 0;
    auto bias_t = torch::empty({0}, x_c.options().dtype(torch::kHalf));

    cnrtDim3_t dim = {task_num, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    conv1d_kernel<<<dim, ktype, queue>>>(
        reinterpret_cast<const half *>(x_c.data_ptr()),
        reinterpret_cast<const half *>(w_c.data_ptr()),
        reinterpret_cast<const half *>(bias_t.data_ptr()),
        reinterpret_cast<half *>(output.data_ptr()),
        batch, in_channels, out_channels, length,
        kernel_size, stride, padding, dilation, groups, L_out,
        has_bias);

    return output;
}
