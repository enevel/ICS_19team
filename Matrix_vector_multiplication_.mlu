#include <bang.h>
#include <cnrt.h>
#include <stdint.h>
#include <torch/extension.h>

#define ALIGN_NUM 64
#define MAX_K 16384

__mlu_func__ int align_up(int x, int a) {
    return (x + a - 1) / a * a;
}

__mlu_entry__ void gemv_kernel(const half *A,
                               const half *B,
                               half *output,
                               int M,
                               int K) {
    __nram__ half nram_a[MAX_K];
    __nram__ half nram_b[MAX_K];
    __nram__ float nram_af[MAX_K];
    __nram__ float nram_bf[MAX_K];
    __nram__ float nram_prod[MAX_K];
    __nram__ half nram_out[1];

    int pad_k = align_up(K, ALIGN_NUM);

    __memcpy(nram_b, B, K * sizeof(half), GDRAM2NRAM);
    __bang_write_value(nram_b + K, pad_k - K, (half)0.0f);
    __bang_half2float(nram_bf, nram_b, pad_k);

    for (int m = taskId; m < M; m += taskDim) {
        __memcpy(nram_a, A + (int64_t)m * K, K * sizeof(half), GDRAM2NRAM);
        __bang_write_value(nram_a + K, pad_k - K, (half)0.0f);

        __bang_half2float(nram_af, nram_a, pad_k);
        __bang_mul(nram_prod, nram_af, nram_bf, pad_k);

        for (int step = pad_k / 2; step >= ALIGN_NUM; step /= 2) {
            __bang_add(nram_prod, nram_prod, nram_prod + step, step);
        }

        float sum = 0.0f;
        for (int i = 0; i < ALIGN_NUM; ++i) {
            sum += nram_prod[i];
        }

        nram_out[0] = (half)sum;
        __memcpy(output + m, nram_out, sizeof(half), NRAM2GDRAM);
    }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.scalar_type() == torch::kHalf, "A must be float16");
    TORCH_CHECK(B.scalar_type() == torch::kHalf, "B must be float16");

    auto A_c = A.contiguous();
    auto B_c = B.contiguous();

    int M = static_cast<int>(A_c.size(0));
    int K = static_cast<int>(A_c.size(1));

    TORCH_CHECK(K <= MAX_K, "K exceeds MAX_K");

    auto output = torch::empty({M, 1}, A_c.options());

    if (M == 0) {
        return output;
    }

    uint32_t task_num = 16;
    if (M < static_cast<int>(task_num)) {
        task_num = static_cast<uint32_t>(M);
    }

    cnrtDim3_t dim = {task_num, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    gemv_kernel<<<dim, ktype, queue>>>(
        reinterpret_cast<const half *>(A_c.data_ptr()),
        reinterpret_cast<const half *>(B_c.data_ptr()),
        reinterpret_cast<half *>(output.data_ptr()),
        M, K);

    return output;
}
