#include <torch/extension.h>

torch::Tensor bang_func(torch::Tensor input_log_prob, torch::Tensor target_prob) {
    TORCH_CHECK(input_log_prob.dim() == 2, "input_log_prob must be 2D");
    TORCH_CHECK(target_prob.dim() == 2, "target_prob must be 2D");
    TORCH_CHECK(input_log_prob.sizes() == target_prob.sizes(),
                "input_log_prob and target_prob must have same shape");
    TORCH_CHECK(input_log_prob.scalar_type() == torch::kFloat16,
                "input_log_prob must be float16");
    TORCH_CHECK(target_prob.scalar_type() == torch::kFloat16,
                "target_prob must be float16");

    int64_t batch = input_log_prob.size(0);

    auto input = input_log_prob.contiguous();
    auto target = target_prob.contiguous();

    auto zero = torch::zeros_like(target);

    // target == 0 时 KL 项按 0 处理，避免 0 * log(0) 产生 NaN
    auto kl_terms = torch::where(
        target > 0,
        target * (torch::log(target) - input),
        zero
    );

    // batchmean: sum over all elements / batch
    auto out = kl_terms.sum() / batch;

    return out;
}