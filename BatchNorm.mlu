#include <bang.h>
#include <cnrt.h>
#include <stdint.h>
#include <torch/extension.h>

#define MAX_SPATIAL 16384

__mlu_entry__ void batchnorm_kernel(const half *input,
                                    half *output,
                                    int batch,
                                    int channels,
                                    int H,
                                    int W) {
    __nram__ half nram_h[MAX_SPATIAL];
    __nram__ float nram_f[MAX_SPATIAL];

    int HW = H * W;
    int count = batch * HW;
    float eps = 1e-5f;

    for (int c = taskId; c < channels; c += taskDim) {
        float sum = 0.0f;
        for (int b = 0; b < batch; ++b) {
            const half *ptr = input + ((int64_t)b * channels + c) * HW;
            __memcpy(nram_h, ptr, HW * sizeof(half), GDRAM2NRAM);

            for (int i = 0; i < HW; ++i) {
                sum += (float)nram_h[i];
            }
        }
        float mean = sum / (float)count;

        float var_sum = 0.0f;
        for (int b = 0; b < batch; ++b) {
            const half *ptr = input + ((int64_t)b * channels + c) * HW;
            __memcpy(nram_h, ptr, HW * sizeof(half), GDRAM2NRAM);

            for (int i = 0; i < HW; ++i) {
                float diff = (float)nram_h[i] - mean;
                var_sum += diff * diff;
            }
        }
        float var = var_sum / (float)count;
        float inv_std = 1.0f / sqrtf(var + eps);

        for (int b = 0; b < batch; ++b) {
            const half *in_ptr = input + ((int64_t)b * channels + c) * HW;
            half *out_ptr = output + ((int64_t)b * channels + c) * HW;

            __memcpy(nram_h, in_ptr, HW * sizeof(half), GDRAM2NRAM);

            for (int i = 0; i < HW; ++i) {
                float val = ((float)nram_h[i] - mean) * inv_std;
                nram_h[i] = (half)val;
            }

            __memcpy(out_ptr, nram_h, HW * sizeof(half), NRAM2GDRAM);
        }
    }
}

torch::Tensor bang_func(torch::Tensor x, int num_features) {
    TORCH_CHECK(x.scalar_type() == torch::kHalf, "Input must be float16");
    TORCH_CHECK(x.dim() == 4, "Input must be 4D [batch, channel, H, W]");

    auto x_c = x.contiguous();

    int batch = static_cast<int>(x_c.size(0));
    int channels = static_cast<int>(x_c.size(1));
    int H = static_cast<int>(x_c.size(2));
    int W = static_cast<int>(x_c.size(3));

    auto output = torch::empty_like(x_c);

    if (channels == 0) {
        return output;
    }

    uint32_t task_num = 16;
    if (channels < static_cast<int>(task_num)) {
        task_num = static_cast<uint32_t>(channels);
    }

    cnrtDim3_t dim = {task_num, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    batchnorm_kernel<<<dim, ktype, queue>>>(
        reinterpret_cast<const half *>(x_c.data_ptr()),
        reinterpret_cast<half *>(output.data_ptr()),
        batch, channels, H, W);

    return output;
}
