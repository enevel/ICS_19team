#include <bang.h>
#include <cnrt.h>
#include <stdint.h>
#include <torch/extension.h>

#define MAX_DIM_SIZE 16384

__mlu_entry__ void argmax_kernel(const half *input,
                                 int64_t *output,
                                 int outer,
                                 int dim_size,
                                 int inner) {
    __nram__ half nram_val[1];

    int total = outer * inner;

    for (int idx = taskId; idx < total; idx += taskDim) {
        int o = idx / inner;
        int i = idx % inner;

        const half *base = input + (int64_t)o * dim_size * inner + i;

        __memcpy(nram_val, base, sizeof(half), GDRAM2NRAM);
        float max_val = (float)nram_val[0];
        int64_t max_idx = 0;

        for (int d = 1; d < dim_size; ++d) {
            __memcpy(nram_val, base + (int64_t)d * inner, sizeof(half), GDRAM2NRAM);
            float v = (float)nram_val[0];
            if (v > max_val) {
                max_val = v;
                max_idx = (int64_t)d;
            }
        }

        __nram__ int64_t nram_out_idx[1];
        nram_out_idx[0] = max_idx;
        __memcpy(output + idx, nram_out_idx, sizeof(int64_t), NRAM2GDRAM);
    }
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
    TORCH_CHECK(x.scalar_type() == torch::kHalf, "Input must be float16");

    auto x_c = x.contiguous();

    if (dim < 0) dim += x_c.dim();
    TORCH_CHECK(dim >= 0 && dim < x_c.dim(), "dim out of range");

    int outer = 1;
    for (int i = 0; i < dim; ++i) {
        outer *= static_cast<int>(x_c.size(i));
    }
    int dim_size = static_cast<int>(x_c.size(dim));
    int inner = 1;
    for (int i = dim + 1; i < x_c.dim(); ++i) {
        inner *= static_cast<int>(x_c.size(i));
    }

    auto out_sizes = x_c.sizes().vec();
    out_sizes.erase(out_sizes.begin() + dim);
    auto output = torch::empty(out_sizes, x_c.options().dtype(torch::kLong));

    int total = outer * inner;
    if (total == 0) {
        return output;
    }

    uint32_t task_num = 16;
    if (total < static_cast<int>(task_num)) {
        task_num = static_cast<uint32_t>(total);
    }

    cnrtDim3_t grid = {task_num, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    argmax_kernel<<<grid, ktype, queue>>>(
        reinterpret_cast<const half *>(x_c.data_ptr()),
        reinterpret_cast<int64_t *>(output.data_ptr()),
        outer, dim_size, inner);

    return output;
}
