#include <bang.h>
#include <cnrt.h>
#include <stdint.h>
#include <torch/extension.h>

#define ALIGN_NUM 64
#define MAX_DIM 16384

__mlu_func__ int align_up(int x, int a) {
    return (x + a - 1) / a * a;
}

__mlu_entry__ void log_softmax_kernel(const half *input,
                                      half *output,
                                      int batch,
                                      int dim_size) {
    __nram__ half nram_h[MAX_DIM];
    __nram__ float nram_f[MAX_DIM];
    __nram__ float nram_tmp[MAX_DIM];
    __nram__ float nram_log[ALIGN_NUM];

    int pad_dim = align_up(dim_size, ALIGN_NUM);

    for (int b = taskId; b < batch; b += taskDim) {
        __memcpy(nram_h, input + (int64_t)b * dim_size,
                 dim_size * sizeof(half), GDRAM2NRAM);

        for (int i = dim_size; i < pad_dim; ++i) {
            nram_h[i] = (half)(-65504.0f);
        }

        __bang_half2float(nram_f, nram_h, pad_dim);

        __memcpy(nram_tmp, nram_f, pad_dim * sizeof(float), NRAM2NRAM);
        for (int step = pad_dim / 2; step >= ALIGN_NUM; step /= 2) {
            __bang_maxequal(nram_tmp, nram_tmp, nram_tmp + step, step);
        }
        float max_val = -3e38f;
        for (int i = 0; i < ALIGN_NUM; ++i) {
            if (nram_tmp[i] > max_val) max_val = nram_tmp[i];
        }

        __bang_sub_scalar(nram_f, nram_f, max_val, pad_dim);

        __memcpy(nram_tmp, nram_f, pad_dim * sizeof(float), NRAM2NRAM);

        for (int i = dim_size; i < pad_dim; ++i) {
            nram_tmp[i] = 0.0f;
        }

        __bang_active_exp(nram_tmp, nram_tmp, pad_dim);

        for (int i = dim_size; i < pad_dim; ++i) {
            nram_tmp[i] = 0.0f;
        }

        for (int step = pad_dim / 2; step >= ALIGN_NUM; step /= 2) {
            __bang_add(nram_tmp, nram_tmp, nram_tmp + step, step);
        }
        float sum_exp = 0.0f;
        for (int i = 0; i < ALIGN_NUM; ++i) {
            sum_exp += nram_tmp[i];
        }

        nram_log[0] = sum_exp;
        __bang_write_value(nram_log + 1, ALIGN_NUM - 1, 1.0f);
        __bang_active_log(nram_log, nram_log, ALIGN_NUM);
        float log_sum = nram_log[0];

        __bang_sub_scalar(nram_f, nram_f, log_sum, pad_dim);

        __bang_float2half_rd(nram_h, nram_f, pad_dim);

        __memcpy(output + (int64_t)b * dim_size, nram_h,
                 dim_size * sizeof(half), NRAM2GDRAM);
    }
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
    TORCH_CHECK(x.scalar_type() == torch::kHalf, "Input must be float16");
    TORCH_CHECK(x.dim() == 2, "Input must be 2D [batch_size, dim]");

    if (dim < 0) dim += x.dim();
    TORCH_CHECK(dim == 0 || dim == 1, "dim must be 0 or 1");

    bool need_transpose = (dim == 0);
    auto input_work = need_transpose ? x.transpose(0, 1).contiguous()
                                     : x.contiguous();

    int batch = static_cast<int>(input_work.size(0));
    int dim_size = static_cast<int>(input_work.size(1));

    TORCH_CHECK(dim_size <= MAX_DIM, "dim_size exceeds MAX_DIM");

    auto output_work = torch::empty_like(input_work);

    if (batch == 0) {
        return need_transpose ? output_work.transpose(0, 1).contiguous()
                              : output_work;
    }

    uint32_t task_num = 16;
    if (batch < static_cast<int>(task_num)) {
        task_num = static_cast<uint32_t>(batch);
    }

    cnrtDim3_t grid_dim = {task_num, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    log_softmax_kernel<<<grid_dim, ktype, queue>>>(
        reinterpret_cast<const half *>(input_work.data_ptr()),
        reinterpret_cast<half *>(output_work.data_ptr()),
        batch,
        dim_size);

    return need_transpose ? output_work.transpose(0, 1).contiguous()
                          : output_work;
}
