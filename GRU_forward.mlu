#include <torch/extension.h>
#include <vector>

torch::Tensor gru_single_layer_forward(
    torch::Tensor input_seq,
    torch::Tensor weight_ih,
    torch::Tensor weight_hh,
    torch::Tensor bias_ih,
    torch::Tensor bias_hh,
    int hidden_size) {

    int64_t batch = input_seq.size(0);
    int64_t seq_len = input_seq.size(1);
    int64_t input_size = input_seq.size(2);

    auto opts = input_seq.options();

    torch::Tensor h = torch::zeros({batch, hidden_size}, opts);

    std::vector<torch::Tensor> outputs;
    outputs.reserve(seq_len);

    auto weight_ih_t = weight_ih.transpose(0, 1).contiguous();
    auto weight_hh_t = weight_hh.transpose(0, 1).contiguous();

    // 一次性计算所有时间步的 input gate:
    // input_seq: [B, T, I]
    // weight_ih_t: [I, 3H]
    // gi_all: [B, T, 3H]
    auto input_2d = input_seq.reshape({batch * seq_len, input_size});
    auto gi_all = torch::matmul(input_2d, weight_ih_t)
                      .reshape({batch, seq_len, 3 * hidden_size});

    gi_all = gi_all + bias_ih.reshape({1, 1, 3 * hidden_size});

    for (int64_t t = 0; t < seq_len; ++t) {
        auto gi = gi_all.select(1, t);

        auto gh = torch::matmul(h, weight_hh_t) +
                  bias_hh.reshape({1, 3 * hidden_size});

        auto i_r = gi.slice(1, 0, hidden_size);
        auto i_z = gi.slice(1, hidden_size, 2 * hidden_size);
        auto i_n = gi.slice(1, 2 * hidden_size, 3 * hidden_size);

        auto h_r = gh.slice(1, 0, hidden_size);
        auto h_z = gh.slice(1, hidden_size, 2 * hidden_size);
        auto h_n = gh.slice(1, 2 * hidden_size, 3 * hidden_size);

        auto r = torch::sigmoid(i_r + h_r);
        auto z = torch::sigmoid(i_z + h_z);
        auto n = torch::tanh(i_n + r * h_n);

        h = (1 - z) * n + z * h;

        outputs.push_back(h.unsqueeze(1));
    }

    return torch::cat(outputs, 1);
}

torch::Tensor bang_func(
    torch::Tensor x,
    torch::Tensor weight_ih_l0,
    torch::Tensor weight_hh_l0,
    torch::Tensor bias_ih_l0,
    torch::Tensor bias_hh_l0,
    torch::Tensor weight_ih_l1,
    torch::Tensor weight_hh_l1,
    torch::Tensor bias_ih_l1,
    torch::Tensor bias_hh_l1,
    int input_size,
    int hidden_size,
    int num_layers) {

    TORCH_CHECK(x.dim() == 3, "x must be [batch, seq_len, input_size]");
    TORCH_CHECK(x.scalar_type() == torch::kFloat16, "x must be float16");
    TORCH_CHECK(num_layers == 2, "This implementation supports num_layers == 2");

    int64_t batch = x.size(0);
    int64_t seq_len = x.size(1);

    TORCH_CHECK(x.size(2) == input_size,
                "input_size does not match x.size(2)");

    TORCH_CHECK(weight_ih_l0.size(0) == 3 * hidden_size &&
                weight_ih_l0.size(1) == input_size,
                "weight_ih_l0 must be [3 * hidden_size, input_size]");

    TORCH_CHECK(weight_hh_l0.size(0) == 3 * hidden_size &&
                weight_hh_l0.size(1) == hidden_size,
                "weight_hh_l0 must be [3 * hidden_size, hidden_size]");

    TORCH_CHECK(weight_ih_l1.size(0) == 3 * hidden_size &&
                weight_ih_l1.size(1) == hidden_size,
                "weight_ih_l1 must be [3 * hidden_size, hidden_size]");

    TORCH_CHECK(weight_hh_l1.size(0) == 3 * hidden_size &&
                weight_hh_l1.size(1) == hidden_size,
                "weight_hh_l1 must be [3 * hidden_size, hidden_size]");

    TORCH_CHECK(bias_ih_l0.numel() == 3 * hidden_size,
                "bias_ih_l0 must be [3 * hidden_size]");
    TORCH_CHECK(bias_hh_l0.numel() == 3 * hidden_size,
                "bias_hh_l0 must be [3 * hidden_size]");
    TORCH_CHECK(bias_ih_l1.numel() == 3 * hidden_size,
                "bias_ih_l1 must be [3 * hidden_size]");
    TORCH_CHECK(bias_hh_l1.numel() == 3 * hidden_size,
                "bias_hh_l1 must be [3 * hidden_size]");

    auto x_c = x.contiguous();

    auto wih0 = weight_ih_l0.contiguous();
    auto whh0 = weight_hh_l0.contiguous();
    auto bih0 = bias_ih_l0.contiguous();
    auto bhh0 = bias_hh_l0.contiguous();

    auto wih1 = weight_ih_l1.contiguous();
    auto whh1 = weight_hh_l1.contiguous();
    auto bih1 = bias_ih_l1.contiguous();
    auto bhh1 = bias_hh_l1.contiguous();

    auto layer0_out = gru_single_layer_forward(
        x_c,
        wih0,
        whh0,
        bih0,
        bhh0,
        hidden_size);

    auto layer1_out = gru_single_layer_forward(
        layer0_out,
        wih1,
        whh1,
        bih1,
        bhh1,
        hidden_size);

    return layer1_out;
}