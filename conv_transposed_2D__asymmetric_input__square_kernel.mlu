#include <bang.h>
#include <cnrt.h>
#include <stdint.h>
#include <torch/extension.h>

#define MAX_W 4096
#define MAX_KS2 64
#define MAX_IC_WEIGHTS 4096

__mlu_entry__ void conv_transpose2d_kernel(const half *x,
                                           const half *weight,
                                           float *output,
                                           int batch,
                                           int in_channels,
                                           int out_channels,
                                           int h_in,
                                           int w_in,
                                           int h_out,
                                           int w_out,
                                           int oc_per_group,
                                           int ic_per_group,
                                           int kernel_size,
                                           int stride,
                                           int padding,
                                           int groups) {
    __nram__ half nram_x_row[MAX_W];
    __nram__ half nram_w_all[MAX_IC_WEIGHTS];
    __nram__ float nram_acc[MAX_W];
    __nram__ float nram_out_f[MAX_W];

    int ks2 = kernel_size * kernel_size;
    int total_tasks = batch * out_channels;

    for (int task = taskId; task < total_tasks; task += taskDim) {
        int b = task / out_channels;
        int oc = task % out_channels;
        int g = oc / oc_per_group;
        int oc_local = oc % oc_per_group;

        for (int ic_l = 0; ic_l < ic_per_group; ++ic_l) {
            int ic = g * ic_per_group + ic_l;
            __memcpy(nram_w_all + ic_l * ks2,
                     weight + ((int64_t)ic * oc_per_group + oc_local) * ks2,
                     ks2 * sizeof(half), GDRAM2NRAM);
        }

        for (int oh = 0; oh < h_out; ++oh) {
            for (int ow_start = 0; ow_start < w_out; ow_start += MAX_W) {
                int cur_w = w_out - ow_start;
                if (cur_w > MAX_W) cur_w = MAX_W;

                for (int t = 0; t < cur_w; ++t) {
                    nram_acc[t] = 0.0f;
                }

                for (int ic_l = 0; ic_l < ic_per_group; ++ic_l) {
                    int ic = g * ic_per_group + ic_l;
                    const half *nram_w = nram_w_all + ic_l * ks2;

                    for (int kh = 0; kh < kernel_size; ++kh) {
                        int h_tmp = oh + padding - kh;
                        if (h_tmp < 0 || h_tmp % stride != 0) continue;
                        int ih = h_tmp / stride;
                        if (ih >= h_in) continue;

                        __memcpy(nram_x_row,
                                 x + ((int64_t)b * in_channels + ic) * h_in * w_in + ih * w_in,
                                 w_in * sizeof(half), GDRAM2NRAM);

                        for (int t = 0; t < cur_w; ++t) {
                            int ow = ow_start + t;
                            for (int kw = 0; kw < kernel_size; ++kw) {
                                int w_tmp = ow + padding - kw;
                                if (w_tmp < 0 || w_tmp % stride != 0) continue;
                                int iw = w_tmp / stride;
                                if (iw >= w_in) continue;

                                nram_acc[t] += (float)nram_x_row[iw]
                                             * (float)nram_w[kh * kernel_size + kw];
                            }
                        }
                    }
                }

                float *dst = output + ((int64_t)b * out_channels + oc) * h_out * w_out
                          + oh * w_out + ow_start;
                __memcpy(dst, nram_acc, cur_w * sizeof(float), NRAM2GDRAM);
            }
        }
    }
}

torch::Tensor bang_func(torch::Tensor x,
                        torch::Tensor weight,
                        int in_channels,
                        int out_channels,
                        int kernel_size,
                        int stride,
                        int padding,
                        int output_padding,
                        int groups,
                        bool bias) {
    auto x_c = x.to(torch::kHalf).contiguous();
    auto w_c = weight.to(torch::kHalf).contiguous();

    int batch = static_cast<int>(x_c.size(0));
    int h_in = static_cast<int>(x_c.size(2));
    int w_in = static_cast<int>(x_c.size(3));

    int h_out = (h_in - 1) * stride - 2 * padding + kernel_size + output_padding;
    int w_out = (w_in - 1) * stride - 2 * padding + kernel_size + output_padding;

    int oc_per_group = out_channels / groups;
    int ic_per_group = in_channels / groups;

    auto output = torch::zeros({batch, out_channels, h_out, w_out},
                               x_c.options().dtype(torch::kFloat32));

    int total_tasks = batch * out_channels;
    if (total_tasks == 0) {
        return output;
    }

    uint32_t task_num = 16;
    if (total_tasks < static_cast<int>(task_num)) {
        task_num = static_cast<uint32_t>(total_tasks);
    }

    cnrtDim3_t dim = {task_num, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    conv_transpose2d_kernel<<<dim, ktype, queue>>>(
        reinterpret_cast<const half *>(x_c.data_ptr()),
        reinterpret_cast<const half *>(w_c.data_ptr()),
        reinterpret_cast<float *>(output.data_ptr()),
        batch, in_channels, out_channels,
        h_in, w_in, h_out, w_out,
        oc_per_group, ic_per_group,
        kernel_size, stride, padding, groups);

    return output;
}
