#include <bang.h>
#include <cnrt.h>
#include <stdint.h>
#include <torch/extension.h>

__mlu_entry__ void cumsum_kernel(const half *input,
                                 half *output,
                                 int outer,
                                 int dim_size,
                                 int inner) {
    __nram__ half nram_val[1];
    __nram__ half nram_out[1];

    int total = outer * inner;

    for (int idx = taskId; idx < total; idx += taskDim) {
        int o = idx / inner;
        int i = idx % inner;

        float running_sum = 0.0f;

        for (int d = 0; d < dim_size; ++d) {
            int64_t pos = ((int64_t)o * dim_size + d) * inner + i;
            __memcpy(nram_val, input + pos, sizeof(half), GDRAM2NRAM);
            running_sum += (float)nram_val[0];
            nram_out[0] = (half)running_sum;
            __memcpy(output + pos, nram_out, sizeof(half), NRAM2GDRAM);
        }
    }
}

torch::Tensor bang_func(torch::Tensor x, int dim) {
    TORCH_CHECK(x.scalar_type() == torch::kHalf, "Input must be float16");

    auto x_c = x.contiguous();

    if (dim < 0) dim += x_c.dim();
    TORCH_CHECK(dim >= 0 && dim < x_c.dim(), "dim out of range");

    int outer = 1;
    for (int i = 0; i < dim; ++i) {
        outer *= static_cast<int>(x_c.size(i));
    }
    int dim_size = static_cast<int>(x_c.size(dim));
    int inner = 1;
    for (int i = dim + 1; i < x_c.dim(); ++i) {
        inner *= static_cast<int>(x_c.size(i));
    }

    auto output = torch::empty_like(x_c);

    int total = outer * inner;
    if (total == 0) {
        return output;
    }

    uint32_t task_num = 16;
    if (total < static_cast<int>(task_num)) {
        task_num = static_cast<uint32_t>(total);
    }

    cnrtDim3_t grid = {task_num, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    cumsum_kernel<<<grid, ktype, queue>>>(
        reinterpret_cast<const half *>(x_c.data_ptr()),
        reinterpret_cast<half *>(output.data_ptr()),
        outer, dim_size, inner);

    return output;
}
