#include <bang.h>
#include <cnrt.h>
#include <stdint.h>
#include <torch/extension.h>

__mlu_entry__ void scatter_add_kernel_fp16(const half *src,
                                           const int64_t *index,
                                           half *out,
                                           int N,
                                           int D,
                                           int dim_size) {
    int total = dim_size * D;

    for (int linear = taskId; linear < total; linear += taskDim) {
        int out_row = linear / D;
        int d = linear - out_row * D;

        half acc = (half)0.0f;

        // 按 n 从小到大累加，尽量和常规 scatter_add 顺序一致
        for (int n = 0; n < N; ++n) {
            int64_t idx = index[n];

            if (idx == out_row) {
                // 每次加完都转回 half，避免 float32 累加导致误差和参考不一致
                float tmp = (float)acc + (float)src[n * D + d];
                acc = (half)tmp;
            }
        }

        out[out_row * D + d] = acc;
    }
}

torch::Tensor bang_func(torch::Tensor src,
                        torch::Tensor index,
                        int dim_size) {
    TORCH_CHECK(src.dim() == 2, "src must be 2D, shape [N, D]");
    TORCH_CHECK(index.dim() == 1, "index must be 1D, shape [N]");
    TORCH_CHECK(index.size(0) == src.size(0),
                "index length must match src.size(0)");
    TORCH_CHECK(src.scalar_type() == torch::kFloat16,
                "src must be float16");
    TORCH_CHECK(index.scalar_type() == torch::kInt64,
                "index must be int64");
    TORCH_CHECK(dim_size >= 0, "dim_size must be non-negative");

    auto src_c = src.contiguous();
    auto index_c = index.contiguous();

    int N = static_cast<int>(src_c.size(0));
    int D = static_cast<int>(src_c.size(1));

    auto out = torch::empty({dim_size, D},
                            src_c.options().dtype(torch::kFloat16));

    uint32_t task_num = 64;
    int total = dim_size * D;

    if (total < static_cast<int>(task_num)) {
        task_num = static_cast<uint32_t>(total);
    }
    if (task_num == 0) {
        task_num = 1;
    }

    cnrtDim3_t dim = {task_num, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    scatter_add_kernel_fp16<<<dim, ktype, queue>>>(
        reinterpret_cast<const half *>(src_c.data_ptr()),
        reinterpret_cast<const int64_t *>(index_c.data_ptr()),
        reinterpret_cast<half *>(out.data_ptr()),
        N,
        D,
        dim_size);

    return out;
}