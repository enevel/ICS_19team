#include <bang.h>
#include <cnrt.h>
#include <stdint.h>
#include <torch/extension.h>

__mlu_entry__ void zero_half_kernel(half *out, int total) {
    for (int i = taskId; i < total; i += taskDim) {
        out[i] = (half)0.0f;
    }
}

__mlu_entry__ void scatter_add_atomic_i64_kernel(const half *src,
                                                 const int64_t *index,
                                                 half *out,
                                                 int total,
                                                 int N,
                                                 int D,
                                                 int dim_size) {
    for (int linear = taskId; linear < total; linear += taskDim) {
        int n = linear / D;
        int d = linear - n * D;

        int64_t row = index[n];

        if (row >= 0 && row < dim_size) {
            int out_offset = (int)row * D + d;
            int src_offset = n * D + d;

            half old_val;
            __bang_atomic_add(&old_val,
                              out + out_offset,
                              src[src_offset]);
        }
    }
}

__mlu_entry__ void scatter_add_atomic_i32_kernel(const half *src,
                                                 const int32_t *index,
                                                 half *out,
                                                 int total,
                                                 int N,
                                                 int D,
                                                 int dim_size) {
    for (int linear = taskId; linear < total; linear += taskDim) {
        int n = linear / D;
        int d = linear - n * D;

        int32_t row = index[n];

        if (row >= 0 && row < dim_size) {
            int out_offset = row * D + d;
            int src_offset = n * D + d;

            half old_val;
            __bang_atomic_add(&old_val,
                              out + out_offset,
                              src[src_offset]);
        }
    }
}

torch::Tensor bang_func(torch::Tensor src,
                        torch::Tensor index,
                        int dim_size) {
    TORCH_CHECK(src.dim() == 2, "src must be 2D, shape [N, D]");
    TORCH_CHECK(index.dim() == 1, "index must be 1D, shape [N]");
    TORCH_CHECK(index.size(0) == src.size(0),
                "index length must match src.size(0)");
    TORCH_CHECK(src.scalar_type() == torch::kFloat16,
                "src must be float16");
    TORCH_CHECK(index.scalar_type() == torch::kInt64 ||
                index.scalar_type() == torch::kInt32,
                "index must be int64 or int32");
    TORCH_CHECK(dim_size >= 0, "dim_size must be non-negative");

    auto src_c = src.contiguous();
    auto index_c = index.contiguous();

    int N = static_cast<int>(src_c.size(0));
    int D = static_cast<int>(src_c.size(1));
    int out_total = dim_size * D;
    int src_total = N * D;

    auto out = torch::empty({dim_size, D},
                            src_c.options().dtype(torch::kFloat16));

    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    uint32_t task_num = 256;

    if (out_total > 0 && out_total < static_cast<int>(task_num)) {
        task_num = static_cast<uint32_t>(out_total);
    }

    if (src_total > out_total && src_total < static_cast<int>(task_num)) {
        task_num = static_cast<uint32_t>(src_total);
    }

    if (task_num == 0) {
        task_num = 1;
    }

    cnrtDim3_t dim = {task_num, 1, 1};

    if (out_total > 0) {
        zero_half_kernel<<<dim, ktype, queue>>>(
            reinterpret_cast<half *>(out.data_ptr()),
            out_total);
    }

    if (src_total > 0 && dim_size > 0) {
        if (index_c.scalar_type() == torch::kInt64) {
            scatter_add_atomic_i64_kernel<<<dim, ktype, queue>>>(
                reinterpret_cast<const half *>(src_c.data_ptr()),
                reinterpret_cast<const int64_t *>(index_c.data_ptr()),
                reinterpret_cast<half *>(out.data_ptr()),
                src_total,
                N,
                D,
                dim_size);
        } else {
            scatter_add_atomic_i32_kernel<<<dim, ktype, queue>>>(
                reinterpret_cast<const half *>(src_c.data_ptr()),
                reinterpret_cast<const int32_t *>(index_c.data_ptr()),
                reinterpret_cast<half *>(out.data_ptr()),
                src_total,
                N,
                D,
                dim_size);
        }
    }

    return out;
}