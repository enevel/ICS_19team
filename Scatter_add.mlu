#include <bang.h>
#include <cnrt.h>
#include <stdint.h>
#include <torch/extension.h>

#define SCATTER_D 256

__mlu_entry__ void scatter_add_kernel_i64(const half *src,
                                          const int64_t *index,
                                          half *out,
                                          int N,
                                          int D,
                                          int dim_size) {
    __nram__ float sum[SCATTER_D];

    for (int out_row = taskId; out_row < dim_size; out_row += taskDim) {
        // 初始化 sum
        for (int d = 0; d < D; ++d) {
            sum[d] = 0.0f;
        }

        // 按 n 从小到大累加
        for (int n = 0; n < N; ++n) {
            int64_t idx = index[n];

            if (idx == out_row) {
                for (int d = 0; d < D; ++d) {
                    sum[d] += (float)src[n * D + d];
                }
            }
        }

        // float 累加，最后 cast 成 half 输出
        for (int d = 0; d < D; ++d) {
            out[out_row * D + d] = (half)sum[d];
        }
    }
}

__mlu_entry__ void scatter_add_kernel_i32(const half *src,
                                          const int32_t *index,
                                          half *out,
                                          int N,
                                          int D,
                                          int dim_size) {
    __nram__ float sum[SCATTER_D];

    for (int out_row = taskId; out_row < dim_size; out_row += taskDim) {
        for (int d = 0; d < D; ++d) {
            sum[d] = 0.0f;
        }

        for (int n = 0; n < N; ++n) {
            int32_t idx = index[n];

            if (idx == out_row) {
                for (int d = 0; d < D; ++d) {
                    sum[d] += (float)src[n * D + d];
                }
            }
        }

        for (int d = 0; d < D; ++d) {
            out[out_row * D + d] = (half)sum[d];
        }
    }
}

torch::Tensor bang_func(torch::Tensor src,
                        torch::Tensor index,
                        int dim_size) {
    TORCH_CHECK(src.dim() == 2, "src must be 2D, shape [N, D]");
    TORCH_CHECK(index.dim() == 1, "index must be 1D, shape [N]");
    TORCH_CHECK(index.size(0) == src.size(0),
                "index length must match src.size(0)");
    TORCH_CHECK(src.scalar_type() == torch::kFloat16,
                "src must be float16");
    TORCH_CHECK(index.scalar_type() == torch::kInt64 ||
                index.scalar_type() == torch::kInt32,
                "index must be int64 or int32");
    TORCH_CHECK(src.size(1) <= SCATTER_D,
                "This implementation expects D <= 256");
    TORCH_CHECK(dim_size >= 0, "dim_size must be non-negative");

    auto src_c = src.contiguous();
    auto index_c = index.contiguous();

    int N = static_cast<int>(src_c.size(0));
    int D = static_cast<int>(src_c.size(1));

    auto out = torch::empty({dim_size, D},
                            src_c.options().dtype(torch::kFloat16));

    uint32_t task_num = 64;
    if (dim_size > 0 && dim_size < static_cast<int>(task_num)) {
        task_num = static_cast<uint32_t>(dim_size);
    }
    if (task_num == 0) {
        task_num = 1;
    }

    cnrtDim3_t dim = {task_num, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    if (dim_size > 0 && N > 0 && D > 0) {
        if (index_c.scalar_type() == torch::kInt64) {
            scatter_add_kernel_i64<<<dim, ktype, queue>>>(
                reinterpret_cast<const half *>(src_c.data_ptr()),
                reinterpret_cast<const int64_t *>(index_c.data_ptr()),
                reinterpret_cast<half *>(out.data_ptr()),
                N,
                D,
                dim_size);
        } else {
            scatter_add_kernel_i32<<<dim, ktype, queue>>>(
                reinterpret_cast<const half *>(src_c.data_ptr()),
                reinterpret_cast<const int32_t *>(index_c.data_ptr()),
                reinterpret_cast<half *>(out.data_ptr()),
                N,
                D,
                dim_size);
        }
    }

    return out;
}