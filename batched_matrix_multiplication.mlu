#include <bang.h>
#include <cnrt.h>
#include <stdint.h>
#include <torch/extension.h>

#define TILE_M 32
#define TILE_K 32
#define TILE_N 256

__mlu_entry__ void bmm_kernel(const half *A,
                              const half *B,
                              half *C,
                              int batch,
                              int m,
                              int k,
                              int n) {
    __nram__ half a_h[TILE_M * TILE_K];
    __nram__ half b_h[TILE_K * TILE_N];
    __nram__ half c_h[TILE_M * TILE_N];
    __nram__ float a_f[TILE_M * TILE_K];
    __nram__ float b_f[TILE_K * TILE_N];
    __nram__ float c_f[TILE_M * TILE_N];
    __nram__ float tmp[TILE_N];

    for (int b_idx = taskId; b_idx < batch; b_idx += taskDim) {
        const half *A_b = A + (int64_t)b_idx * m * k;
        const half *B_b = B + (int64_t)b_idx * k * n;
        half *C_b = C + (int64_t)b_idx * m * n;

        for (int i = 0; i < m; i += TILE_M) {
            int tm = m - i;
            if (tm > TILE_M) tm = TILE_M;

            for (int j = 0; j < n; j += TILE_N) {
                int tn = n - j;
                if (tn > TILE_N) tn = TILE_N;

                __bang_write_value(c_f, TILE_M * TILE_N, 0.0f);

                for (int l = 0; l < k; l += TILE_K) {
                    int tk = k - l;
                    if (tk > TILE_K) tk = TILE_K;

                    for (int r = 0; r < tm; ++r) {
                        __memcpy(a_h + r * TILE_K,
                                 A_b + (i + r) * k + l,
                                 tk * sizeof(half), GDRAM2NRAM);
                        for (int p = tk; p < TILE_K; ++p) {
                            a_h[r * TILE_K + p] = (half)0.0f;
                        }
                    }
                    for (int r = tm; r < TILE_M; ++r) {
                        for (int p = 0; p < TILE_K; ++p) {
                            a_h[r * TILE_K + p] = (half)0.0f;
                        }
                    }

                    for (int r = 0; r < tk; ++r) {
                        __memcpy(b_h + r * TILE_N,
                                 B_b + (l + r) * n + j,
                                 tn * sizeof(half), GDRAM2NRAM);
                        for (int p = tn; p < TILE_N; ++p) {
                            b_h[r * TILE_N + p] = (half)0.0f;
                        }
                    }
                    for (int r = tk; r < TILE_K; ++r) {
                        for (int p = 0; p < TILE_N; ++p) {
                            b_h[r * TILE_N + p] = (half)0.0f;
                        }
                    }

                    __bang_half2float(a_f, a_h, TILE_M * TILE_K);
                    __bang_half2float(b_f, b_h, TILE_K * TILE_N);

                    for (int kk = 0; kk < tk; ++kk) {
                        float *b_row = b_f + kk * TILE_N;
                        for (int ii = 0; ii < tm; ++ii) {
                            float a_val = a_f[ii * TILE_K + kk];
                            if (a_val != 0.0f) {
                                __bang_mul_scalar(tmp, b_row, a_val, TILE_N);
                                __bang_add(c_f + ii * TILE_N,
                                           c_f + ii * TILE_N, tmp, TILE_N);
                            }
                        }
                    }
                }

                __bang_float2half_rd(c_h, c_f, TILE_M * TILE_N);

                for (int r = 0; r < tm; ++r) {
                    __memcpy(C_b + (i + r) * n + j,
                             c_h + r * TILE_N,
                             tn * sizeof(half), NRAM2GDRAM);
                }
            }
        }
    }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.scalar_type() == torch::kHalf, "A must be float16");
    TORCH_CHECK(B.scalar_type() == torch::kHalf, "B must be float16");
    TORCH_CHECK(A.dim() == 3 && B.dim() == 3, "A and B must be 3D");

    auto A_c = A.contiguous();
    auto B_c = B.contiguous();

    int batch = static_cast<int>(A_c.size(0));
    int m = static_cast<int>(A_c.size(1));
    int k = static_cast<int>(A_c.size(2));
    int n = static_cast<int>(B_c.size(2));

    auto C = torch::empty({batch, m, n}, A_c.options());

    if (batch == 0) {
        return C;
    }

    uint32_t task_num = 16;
    if (batch < static_cast<int>(task_num)) {
        task_num = static_cast<uint32_t>(batch);
    }

    cnrtDim3_t dim = {task_num, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    bmm_kernel<<<dim, ktype, queue>>>(
        reinterpret_cast<const half *>(A_c.data_ptr()),
        reinterpret_cast<const half *>(B_c.data_ptr()),
        reinterpret_cast<half *>(C.data_ptr()),
        batch, m, k, n);

    return C;
}
