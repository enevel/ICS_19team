#include <bang.h>
#include <cnrt.h>
#include <stdint.h>
#include <torch/extension.h>

#define TILE_N 512
#define TILE_K 512
#define ALIGN_NUM 64

__mlu_func__ int align_up(int x, int a) {
    return (x + a - 1) / a * a;
}

__mlu_entry__ void bmm_kernel(const half *A,
                              const half *B,
                              float *C,
                              int batch,
                              int m,
                              int k,
                              int n) {
    __nram__ half nram_a_h[TILE_K];
    __nram__ half nram_b_h[TILE_N];
    __nram__ float nram_b_f[TILE_N];
    __nram__ float nram_c_f[TILE_N];
    __nram__ float nram_tmp[TILE_N];

    int total_rows = batch * m;

    for (int row_idx = taskId; row_idx < total_rows; row_idx += taskDim) {
        int b = row_idx / m;
        int i = row_idx % m;

        const half *A_row = A + ((int64_t)b * m + i) * k;
        const half *B_b = B + (int64_t)b * k * n;
        float *C_row = C + ((int64_t)b * m + i) * n;

        for (int j = 0; j < n; j += TILE_N) {
            int tn = n - j;
            if (tn > TILE_N) tn = TILE_N;
            int pad_tn = align_up(tn, ALIGN_NUM);

            __bang_write_value(nram_c_f, pad_tn, 0.0f);

            for (int lk = 0; lk < k; lk += TILE_K) {
                int tk = k - lk;
                if (tk > TILE_K) tk = TILE_K;

                __memcpy(nram_a_h, A_row + lk,
                         tk * sizeof(half), GDRAM2NRAM);

                for (int kk = 0; kk < tk; ++kk) {
                    float a_val = (float)nram_a_h[kk];
                    if (a_val == 0.0f) continue;

                    __memcpy(nram_b_h, B_b + (int64_t)(lk + kk) * n + j,
                             tn * sizeof(half), GDRAM2NRAM);

                    if (tn < pad_tn) {
                        __bang_write_value(nram_b_h + tn, pad_tn - tn, (half)0.0f);
                    }

                    __bang_half2float(nram_b_f, nram_b_h, pad_tn);
                    __bang_mul_scalar(nram_tmp, nram_b_f, a_val, pad_tn);
                    __bang_add(nram_c_f, nram_c_f, nram_tmp, pad_tn);
                }
            }

            __memcpy(C_row + j, nram_c_f,
                     tn * sizeof(float), NRAM2GDRAM);
        }
    }
}

torch::Tensor bang_func(torch::Tensor A, torch::Tensor B) {
    TORCH_CHECK(A.scalar_type() == torch::kHalf, "A must be float16");
    TORCH_CHECK(B.scalar_type() == torch::kHalf, "B must be float16");
    TORCH_CHECK(A.dim() == 3 && B.dim() == 3, "A and B must be 3D");

    auto A_c = A.contiguous();
    auto B_c = B.contiguous();

    int batch = static_cast<int>(A_c.size(0));
    int m = static_cast<int>(A_c.size(1));
    int k = static_cast<int>(A_c.size(2));
    int n = static_cast<int>(B_c.size(2));

    auto C = torch::empty({batch, m, n},
                          A_c.options().dtype(torch::kFloat32));

    int total_rows = batch * m;
    if (total_rows == 0) {
        return C;
    }

    uint32_t task_num = 16;

    cnrtDim3_t dim = {task_num, 1, 1};
    cnrtFunctionType_t ktype = cnrtFuncTypeBlock;
    cnrtQueue_t queue = torch_mlu::getCurMLUStream();

    bmm_kernel<<<dim, ktype, queue>>>(
        reinterpret_cast<const half *>(A_c.data_ptr()),
        reinterpret_cast<const half *>(B_c.data_ptr()),
        reinterpret_cast<float *>(C.data_ptr()),
        batch, m, k, n);

    return C;
}
